{% assign faqs = product.metafields["$app"].faqs.value %}
{% if product and faqs != blank %}
  <section
    class="product-faqs"
    aria-label="{% if block.settings.show_heading %}{{ block.settings.heading | escape }}{% else %}{{ 'accessibility.faq_heading' | t }}{% endif %}"
  >
    {% if block.settings.show_heading %}
      <h2 class="product-faqs__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    <div class="product-faqs__items">
      {% for faq in faqs %}
        {% if faq.question != blank and faq.answer != blank %}
          <details class="product-faqs__item">
            <summary class="product-faqs__question">{{ faq.question | escape }}</summary>
            <div class="product-faqs__answer">
              {% if faq.useProductDescription and product.description != blank %}
                {{ product.description }}
              {% else %}
                {{ faq.answer | escape | newline_to_br }}
              {% endif %}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product FAQs",
  "target": "section",
  "stylesheet": "product-faqs.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
